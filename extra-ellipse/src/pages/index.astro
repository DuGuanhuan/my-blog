---
import Shell from '../components/Shell.astro';
import AlbumShelf from '../components/AlbumShelf.astro';
import NowReading from '../components/NowReading.astro';
import { listAlbums, listPosts, listCurrentlyReading } from '../lib/notion';

const posts = await listPosts({ includeDrafts: false });
const latest = posts.slice(0, 3);

// Fetch currently reading books (gracefully handle empty)
let currentlyReading: Awaited<ReturnType<typeof listCurrentlyReading>> = [];
let albums: Awaited<ReturnType<typeof listAlbums>> = [];
try {
  currentlyReading = await listCurrentlyReading(6);
} catch {
  currentlyReading = [];
}
try {
  albums = await listAlbums();
} catch {
  albums = [];
}

function fmtDate(iso?: string): string {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00');
  return d
    .toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
    .replaceAll('/', '.');
}
---

<Shell
  title="Plan B Blog — Becoming in Public"
  description="记录成长、思考工具，以及真实生活的片刻。一个从 Notion 到 Astro 的公开蜕变实验场。"
>
  <!-- Hero -->
  <section class="hero content-wide">
    <div class="hero-grid">
      <small class="hero-kicker">Becoming in Public</small>
      <h1 class="hero-title">Notes toward<br />a life of my own.</h1>
      <p class="hero-quote"><em>Write to become. Build to be free.</em></p>
      <p class="hero-statement-copy">
        关于如何成长、如何思考，以及如何在既定路径之外，慢慢建立属于自己的生活。
      </p>
      <a class="btn primary hero-cta" href="/blog">浏览文章</a>
      <p class="hero-themes" aria-label="长期书写的四个主题">
        <span>Becoming</span>
        <span>Thinking Tools</span>
        <span>Lived Experience</span>
        <span>Quiet Essays</span>
      </p>
    </div>
  </section>

  <section class="home-zine content-wide" aria-labelledby="home-zine-title">
    <a href="/zines/beihai-september">
      <figure>
        <img
          src="/zines/beihai-september/pages/page-01.webp"
          alt="《北海：九月的短暂》Zine 封面"
          width="1280"
          height="1809"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="home-zine__copy">
        <p>New travel zine <span>15 pages</span></p>
        <h2 id="home-zine-title">北海：九月的短暂</h2>
        <p>四天，十八张原片。关于海、身体，以及短暂松下来的一本旅行小志。</p>
        <span class="home-zine__link">在线翻阅 <span aria-hidden="true">→</span></span>
      </div>
    </a>
  </section>

  {albums.length > 0 && <div class="content-wide"><AlbumShelf albums={albums} /></div>}

  <!-- Now Reading -->
  {currentlyReading.length > 0 && <div class="content-wide"><NowReading books={currentlyReading} /></div>}

  <section class="home-latest content-wide" aria-labelledby="home-latest-title">
    <header class="home-latest__header">
      <div>
        <h2 id="home-latest-title">最新文章</h2>
        <p>Recent writing and notes.</p>
      </div>
      <a href="/blog">查看全部文章 <span aria-hidden="true">→</span></a>
    </header>

    <div class="home-latest__list">
      {latest.map((post) => (
        <article class:list={['home-post', { 'home-post--with-cover': Boolean(post.cover) }]}>
          <a href={`/blog/${post.slug}`}>
            <div class="home-post__copy">
              <div class="home-post__meta">
                {post.publishedAt ? <time datetime={post.publishedAt}>{fmtDate(post.publishedAt)}</time> : null}
                {post.category ? <span>{post.category}</span> : null}
              </div>
              <h3>{post.title}</h3>
              {post.excerpt ? <p>{post.excerpt}</p> : null}
            </div>
            {post.cover ? (
              <figure>
                <img src={post.cover} alt="" loading="lazy" decoding="async" />
              </figure>
            ) : null}
            <span class="home-post__arrow" aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>
</Shell>

<style>
  .home-zine {
    padding: 44px 0;
    border-bottom: 1px solid var(--line);
  }

  .home-zine > a {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: clamp(34px, 6vw, 70px);
    align-items: center;
    padding: 30px clamp(28px, 5vw, 54px);
    border: 1px solid rgba(17, 17, 17, .1);
    background: #e8e1d5;
    text-decoration: none;
  }

  .home-zine figure {
    position: relative;
    margin: 0;
  }

  .home-zine figure::before {
    position: absolute;
    inset: -9px 9px 9px -9px;
    border-top: 7px solid #e1b832;
    border-left: 7px solid #3565bd;
    content: '';
  }

  .home-zine figure img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 18px 38px rgba(42, 34, 24, .17);
    transition: transform .25s ease;
  }

  .home-zine > a:hover figure img {
    transform: translateY(-3px) rotate(-.5deg);
  }

  .home-zine__copy > p:first-child {
    display: flex;
    gap: 12px;
    margin: 0;
    color: rgba(17, 17, 17, .46);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .home-zine__copy > p:first-child span {
    color: #3565bd;
  }

  .home-zine h2 {
    margin: 12px 0 14px;
    font-family: var(--serif);
    font-size: clamp(32px, 4.5vw, 50px);
    font-weight: 650;
    letter-spacing: -.035em;
    line-height: 1.08;
  }

  .home-zine__copy > p:nth-of-type(2) {
    max-width: 34em;
    margin: 0;
    color: rgba(17, 17, 17, .62);
    font-family: var(--serif);
    font-size: 14px;
    line-height: 1.8;
  }

  .home-zine__link {
    display: inline-block;
    margin-top: 24px;
    color: rgba(17, 17, 17, .72);
    font-size: 11px;
    font-weight: 650;
  }

  .home-zine__link > span {
    display: inline-block;
    margin-left: 5px;
    transition: transform .16s ease;
  }

  .home-zine > a:hover .home-zine__link > span {
    transform: translateX(4px);
  }

  .home-latest {
    padding: 46px 0 64px;
    border-top: 1px solid var(--line);
  }

  .home-latest__header {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 18px;
  }

  .home-latest__header h2,
  .home-latest__header p {
    margin: 0;
  }

  .home-latest__header h2 {
    color: rgba(17, 17, 17, .82);
    font-family: var(--serif);
    font-size: clamp(21px, 2.7vw, 27px);
    font-weight: 600;
    letter-spacing: .02em;
  }

  .home-latest__header p {
    margin-top: 3px;
    color: rgba(17, 17, 17, .38);
    font-size: 11px;
  }

  .home-latest__header > a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: rgba(17, 17, 17, .54);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .home-latest__header > a:hover {
    color: rgba(17, 17, 17, .88);
  }

  .home-latest__list {
    border-top: 1px solid var(--line2);
  }

  .home-post {
    border-bottom: 1px solid var(--line);
  }

  .home-post > a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 26px;
    padding: 26px 34px 26px 0;
    text-decoration: none;
  }

  .home-post__copy {
    min-width: 0;
  }

  .home-post__meta {
    display: flex;
    flex-wrap: wrap;
    color: rgba(17, 17, 17, .46);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
  }

  .home-post__meta > * + *::before {
    margin: 0 9px;
    content: '·';
    color: rgba(17, 17, 17, .26);
  }

  .home-post h3 {
    margin: 8px 0 0;
    font-family: var(--serif);
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1.32;
    letter-spacing: -.012em;
    text-wrap: balance;
  }

  .home-post__copy > p {
    display: -webkit-box;
    max-width: 46em;
    margin: 10px 0 0;
    overflow: hidden;
    color: rgba(17, 17, 17, .61);
    font-family: var(--serif);
    font-size: 14px;
    line-height: 1.7;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .home-post figure {
    width: 132px;
    aspect-ratio: 4 / 3;
    align-self: center;
    margin: 0;
    overflow: hidden;
    border-radius: 7px;
    background: var(--paper2);
  }

  .home-post figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-post__arrow {
    position: absolute;
    top: 26px;
    right: 0;
    color: rgba(17, 17, 17, .32);
    font-size: 13px;
    transition: color .16s ease, transform .16s ease;
  }

  .home-post > a:hover .home-post__arrow {
    color: rgba(17, 17, 17, .82);
    transform: translate(2px, -2px);
  }

  @media (max-width: 680px) {
    .home-zine {
      padding: 34px 0;
    }

    .home-zine > a {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 22px;
      align-items: start;
      padding: 24px 20px;
    }

    .home-zine h2 {
      margin-top: 8px;
      font-size: 27px;
    }

    .home-zine__copy > p:nth-of-type(2) {
      font-size: 13px;
      line-height: 1.65;
    }

    .home-zine__link {
      margin-top: 16px;
    }

    .home-latest {
      padding: 40px 0 52px;
    }

    .home-latest__header p {
      display: none;
    }

    .home-latest__header > a {
      font-size: 11px;
    }

    .home-post > a {
      display: block;
      padding: 24px 24px 24px 0;
    }

    .home-post h3 {
      font-size: 21px;
    }

    .home-post figure {
      width: 100%;
      margin-top: 16px;
      aspect-ratio: 16 / 9;
    }

    .home-post__arrow {
      top: 25px;
    }
  }
</style>
