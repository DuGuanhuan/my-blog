---
import Shell from '../../components/Shell.astro';

const pdfUrl = '/zines/beihai-september/beihai-september-zine.pdf';
const pageDescriptions = [
  '封面：蓝色纸张与撕纸拼贴中，一位旅行者站在北海礁石上，标题为九月——北海。',
  'Day 1 文字页：进入状态，从侨港风情街的一碗蟹仔粉开启旅行。',
  'Day 1 照片拼贴：蟹仔粉、椰树下的道路与银滩草地。',
  'Day 1 夜晚：酒店建筑与夜景照片，标题为先慢下来。',
  '涠洲岛日落主视觉：夕阳、海面与橙红色蜡笔肌理。',
  'Day 2 涠洲岛：海边礁石上的人、海滩与海面照片。',
  'Day 2 照片拼贴：灯塔、海岸、船与傍晚日落。',
  'Day 2 文字页：船在傍晚慢下来，这一天只有照片、海和风。',
  'Day 3 文字页：阴天 citywalk，老街、海鲜、咖啡、糖水与珍珠。',
  'Day 3 旧楼主视觉：拱门与台阶旁的旅行者，配以黄色手绘线条。',
  'Day 3 照片拼贴：旧建筑、拱门人像与酒店夜景。',
  'Day 4 文字页：戴耳机听 Pacific，在银滩慢一点走。',
  'Day 4 银滩主视觉：辽阔天空、海岸与远处灯塔。',
  'Day 4 银滩照片：高处海景、沙滩与鸡蛋咖啡。',
  '尾声：旅行没有解决焦虑，只是让人短暂地松下来。',
];

const pages = pageDescriptions.map((alt, index) => {
  const number = index + 1;
  return {
    number,
    alt,
    src: `/zines/beihai-september/pages/page-${String(number).padStart(2, '0')}.webp`,
  };
});

const spreads = [];
for (let index = 1; index < pages.length; index += 2) {
  spreads.push(pages.slice(index, index + 2));
}

const bookSheets = [];
for (let index = 0; index < pages.length; index += 2) {
  bookSheets.push({ front: pages[index], back: pages[index + 1] });
}
---

<Shell
  title="北海：九月的短暂 — Travel Zine"
  description="四天，十八张原片，一本关于短暂松下来的北海旅行小志。"
  image={pages[0].src}
  type="article"
>
  <article class="zine-page">
    <header class="zine-hero content-wide">
      <div class="zine-heading">
        <p class="zine-kicker">Travel Zine · No. 01</p>
        <h1>北海：<br /><em>九月的短暂</em></h1>
        <p class="zine-dek">四天，十八张原片。一本关于海、身体，以及短暂松下来的旅行小志。</p>

        <dl class="zine-meta">
          <div>
            <dt>Journey</dt>
            <dd>2026.09.11—09.14</dd>
          </div>
          <div>
            <dt>Edition</dt>
            <dd>15 pages · A5</dd>
          </div>
        </dl>

        <div class="zine-actions">
          <a class="zine-read-link" href="#read-zine">开始翻阅 <span aria-hidden="true">↓</span></a>
          <a class="zine-download-link" href={pdfUrl} download>下载 PDF <span>23 MB</span></a>
        </div>
      </div>

      <figure class="zine-cover">
        <div>
          <img
            src={pages[0].src}
            alt={pages[0].alt}
            width="1280"
            height="1809"
            fetchpriority="high"
          />
        </div>
        <figcaption><span>01</span> / 15</figcaption>
      </figure>
    </header>

    <section class="zine-note content-reading" aria-labelledby="zine-note-title">
      <p>Field note</p>
      <div>
        <h2 id="zine-note-title">在熟悉的生活之外，短暂换一种呼吸。</h2>
        <p>从侨港的一碗蟹仔粉，到涠洲岛的风与落日；从阴天里走进旧楼，到最后一天戴着耳机散步在银滩。旅行没有解决焦虑，只是让紧绷的身体，暂时松了下来。</p>
      </div>
    </section>

    <section class="zine-reader" id="read-zine" aria-labelledby="zine-reader-title">
      <header class="reader-heading content-wide">
        <div>
          <p>Online edition</p>
          <h2 id="zine-reader-title">翻阅全册</h2>
        </div>
        <span>桌面点击翻页 · 手机向下阅读</span>
      </header>

      <div class="book-reader" data-book-reader data-spread="0">
        <div class="book-stage" data-book-stage>
          <div class="book-board" aria-hidden="true"></div>
          {bookSheets.map((sheet, index) => (
            <div
              class="book-sheet"
              data-book-sheet
              style={`--sheet-depth: ${bookSheets.length - index}`}
              aria-hidden="true"
            >
              <div class="book-face book-front">
                <img
                  src={sheet.front.src}
                  alt=""
                  width="1280"
                  height="1809"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="book-face book-back">
                {sheet.back ? (
                  <img
                    src={sheet.back.src}
                    alt=""
                    width="1280"
                    height="1809"
                    loading="lazy"
                    decoding="async"
                  />
                ) : <span></span>}
              </div>
            </div>
          ))}
          <button class="book-hotspot book-hotspot--previous" type="button" data-book-previous aria-label="翻到上一组页面"></button>
          <button class="book-hotspot book-hotspot--next" type="button" data-book-next aria-label="翻到下一组页面"></button>
        </div>

        <div class="book-controls">
          <button type="button" data-book-previous>← 上一页</button>
          <p data-book-status aria-live="polite">封面 · 01 / 15</p>
          <button type="button" data-book-next>翻页 →</button>
        </div>
      </div>

      <ol class="sr-only">
        {pages.map((page) => <li>第 {page.number} 页：{page.alt}</li>)}
      </ol>

      <div class="zine-spreads zine-spreads--mobile">
        {spreads.map((spread) => (
          <figure class="zine-spread">
            {spread.map((page) => (
              <div class="zine-sheet">
                <img
                  src={page.src}
                  alt={page.alt}
                  width="1280"
                  height="1809"
                  loading="lazy"
                  decoding="async"
                />
                <span aria-hidden="true">{String(page.number).padStart(2, '0')}</span>
              </div>
            ))}
          </figure>
        ))}
      </div>
    </section>

    <footer class="zine-ending content-reading">
      <p class="zine-ending-kicker">Coda</p>
      <blockquote>
        <p>旅行没有解决它，<br />只是让我短暂地松下来。</p>
      </blockquote>
      <p class="zine-ending-note">北海 · 2026 年 9 月</p>
      <a href={pdfUrl} download>保存完整 PDF <span aria-hidden="true">↓</span></a>
    </footer>
  </article>
</Shell>

<script>
  const reader = document.querySelector<HTMLElement>('[data-book-reader]');

  if (reader) {
    const sheets = Array.from(reader.querySelectorAll<HTMLElement>('[data-book-sheet]'));
    const previousButtons = reader.querySelectorAll<HTMLButtonElement>('[data-book-previous]');
    const nextButtons = reader.querySelectorAll<HTMLButtonElement>('[data-book-next]');
    const status = reader.querySelector<HTMLElement>('[data-book-status]');
    const stage = reader.querySelector<HTMLElement>('[data-book-stage]');
    const lastSpread = sheets.length - 1;
    let currentSpread = 0;
    let touchStartX = 0;
    let lastSwipeAt = 0;

    const updateBook = () => {
      reader.dataset.spread = String(currentSpread);

      sheets.forEach((sheet, index) => {
        const turned = index < currentSpread;
        sheet.classList.toggle('is-turned', turned);
        sheet.style.zIndex = String(turned ? index + 1 : sheets.length - index);
      });

      previousButtons.forEach((button) => { button.disabled = currentSpread === 0; });
      nextButtons.forEach((button) => { button.disabled = currentSpread === lastSpread; });

      if (status) {
        if (currentSpread === 0) {
          status.textContent = '封面 · 01 / 15';
        } else {
          const leftPage = currentSpread * 2;
          const rightPage = Math.min(leftPage + 1, 15);
          status.textContent = `${String(leftPage).padStart(2, '0')}—${String(rightPage).padStart(2, '0')} / 15`;
        }
      }
    };

    const previous = () => {
      if (currentSpread === 0) return;
      currentSpread -= 1;
      updateBook();
    };

    const next = () => {
      if (currentSpread === lastSpread) return;
      currentSpread += 1;
      updateBook();
    };

    previousButtons.forEach((button) => button.addEventListener('click', () => {
      if (Date.now() - lastSwipeAt > 500) previous();
    }));
    nextButtons.forEach((button) => button.addEventListener('click', () => {
      if (Date.now() - lastSwipeAt > 500) next();
    }));

    window.addEventListener('keydown', (event) => {
      if (!reader.matches(':hover') && !reader.contains(document.activeElement)) return;
      if (event.key === 'ArrowLeft') previous();
      if (event.key === 'ArrowRight') next();
    });

    stage?.addEventListener('touchstart', (event) => {
      touchStartX = event.changedTouches[0]?.clientX ?? 0;
    }, { passive: true });

    stage?.addEventListener('touchend', (event) => {
      const distance = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
      if (Math.abs(distance) < 45) return;
      lastSwipeAt = Date.now();
      if (distance < 0) next();
      else previous();
    }, { passive: true });

    updateBook();
  }
</script>

<style>
  .zine-page {
    --zine-blue: #3565bd;
    --zine-red: #c9563d;
    --zine-yellow: #e3b92d;
    padding: 66px 0 88px;
  }

  .zine-hero {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(340px, .78fr);
    gap: clamp(54px, 9vw, 112px);
    align-items: center;
    padding-bottom: 86px;
  }

  .zine-kicker,
  .zine-note > p,
  .reader-heading p,
  .zine-ending-kicker {
    margin: 0;
    color: rgba(17, 17, 17, .48);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .zine-kicker::before {
    display: inline-block;
    width: 24px;
    height: 5px;
    margin-right: 10px;
    background: var(--zine-blue);
    content: '';
    vertical-align: 1px;
  }

  .zine-heading h1 {
    margin: 22px 0 20px;
    font-family: var(--serif);
    font-size: clamp(48px, 6.5vw, 76px);
    font-weight: 700;
    letter-spacing: -.05em;
    line-height: .98;
  }

  .zine-heading h1 em {
    color: var(--zine-blue);
    font-style: normal;
  }

  .zine-dek {
    max-width: 30em;
    margin: 0;
    color: rgba(17, 17, 17, .64);
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.8;
  }

  .zine-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 400px;
    margin: 34px 0 0;
    border-top: 1px solid var(--line2);
    border-bottom: 1px solid var(--line2);
  }

  .zine-meta div {
    padding: 14px 0;
  }

  .zine-meta div + div {
    padding-left: 22px;
    border-left: 1px solid var(--line);
  }

  .zine-meta dt {
    color: rgba(17, 17, 17, .4);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .zine-meta dd {
    margin: 5px 0 0;
    color: rgba(17, 17, 17, .76);
    font-family: var(--serif);
    font-size: 12px;
  }

  .zine-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .zine-actions a,
  .zine-ending > a {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 16px;
    border: 1px solid rgba(17, 17, 17, .14);
    color: rgba(17, 17, 17, .72);
    font-size: 11px;
    font-weight: 650;
    text-decoration: none;
  }

  .zine-actions a:hover,
  .zine-ending > a:hover {
    border-color: rgba(17, 17, 17, .28);
    color: var(--ink);
  }

  .zine-actions .zine-read-link {
    border-color: var(--zine-blue);
    background: var(--zine-blue);
    color: white;
  }

  .zine-actions .zine-read-link:hover {
    border-color: #2854a6;
    background: #2854a6;
    color: white;
  }

  .zine-download-link span {
    color: rgba(17, 17, 17, .36);
    font-size: 9px;
  }

  .zine-cover {
    margin: 0;
  }

  .zine-cover > div {
    position: relative;
    padding: 18px;
    background: #e8e0d2;
  }

  .zine-cover > div::before {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 42%;
    height: 36%;
    border-top: 10px solid var(--zine-yellow);
    border-right: 10px solid var(--zine-yellow);
    content: '';
  }

  .zine-cover img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 24px 54px rgba(42, 34, 24, .2);
  }

  .zine-cover figcaption {
    margin-top: 12px;
    color: rgba(17, 17, 17, .34);
    font-family: var(--serif);
    font-size: 10px;
    text-align: right;
  }

  .zine-cover figcaption span {
    color: rgba(17, 17, 17, .7);
  }

  .zine-note {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 28px;
    padding: 58px 0 72px;
    border-top: 1px solid var(--line2);
  }

  .zine-note h2 {
    max-width: 14em;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 600;
    letter-spacing: -.025em;
    line-height: 1.18;
  }

  .zine-note div > p {
    max-width: 38em;
    margin: 24px 0 0;
    color: rgba(17, 17, 17, .64);
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.9;
  }

  .zine-reader {
    position: relative;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    padding: 68px max(22px, calc((100vw - 1200px) / 2)) 86px;
    background: #ded7ca;
  }

  .reader-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 34px;
  }

  .reader-heading h2 {
    margin: 6px 0 0;
    font-family: var(--serif);
    font-size: 31px;
    font-weight: 600;
  }

  .reader-heading > span {
    color: rgba(17, 17, 17, .42);
    font-size: 10px;
  }

  .book-reader {
    width: min(100%, 1120px);
    margin: 0 auto;
    overflow: visible;
  }

  .book-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2560 / 1809;
    perspective: 2400px;
    transform: translateX(0);
    transform-style: preserve-3d;
    transition: transform .8s cubic-bezier(.22, .72, .2, 1);
  }

  .book-reader[data-spread='0'] .book-stage {
    transform: translateX(-25%);
  }

  .book-board {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(67, 51, 31, .16);
    background:
      linear-gradient(90deg, transparent 49.7%, rgba(61, 46, 28, .15) 50%, transparent 50.3%),
      #eee8de;
    box-shadow: 0 28px 64px rgba(54, 43, 29, .2);
    opacity: 1;
    transition: opacity .25s ease;
  }

  .book-reader[data-spread='0'] .book-board {
    opacity: 0;
  }

  .book-sheet {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: var(--sheet-depth);
    width: 50%;
    transform: rotateY(0deg);
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform .9s cubic-bezier(.55, .08, .25, .98);
    will-change: transform;
  }

  .book-sheet.is-turned {
    transform: rotateY(-180deg);
  }

  .book-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #f4efe5;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .book-face img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-front {
    box-shadow: inset 16px 0 18px -20px rgba(44, 34, 22, .45);
  }

  .book-front::after,
  .book-back::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: '';
  }

  .book-front::after {
    background: linear-gradient(90deg, rgba(36, 27, 16, .16), transparent 12%);
  }

  .book-back {
    transform: rotateY(180deg);
    box-shadow: inset -16px 0 18px -20px rgba(44, 34, 22, .45);
  }

  .book-back::after {
    background: linear-gradient(270deg, rgba(36, 27, 16, .16), transparent 12%);
  }

  .book-back > span {
    display: block;
    width: 100%;
    height: 100%;
    background: #eee8dc;
  }

  .book-hotspot {
    position: absolute;
    z-index: 30;
    top: 0;
    bottom: 0;
    width: 50%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .book-hotspot--previous {
    left: 0;
    cursor: w-resize;
  }

  .book-hotspot--next {
    right: 0;
    cursor: e-resize;
  }

  .book-hotspot:disabled {
    cursor: default;
    pointer-events: none;
  }

  .book-hotspot:focus-visible {
    outline: 2px solid rgba(17, 17, 17, .7);
    outline-offset: 6px;
  }

  .book-controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-top: 34px;
  }

  .book-controls button {
    justify-self: start;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: rgba(17, 17, 17, .68);
    cursor: pointer;
    font-family: var(--serif);
    font-size: 12px;
  }

  .book-controls button:last-child {
    justify-self: end;
  }

  .book-controls button:hover:not(:disabled) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .book-controls button:disabled {
    color: rgba(17, 17, 17, .24);
    cursor: default;
  }

  .book-controls p {
    margin: 0;
    color: rgba(17, 17, 17, .45);
    font-size: 9px;
    font-variant-numeric: tabular-nums;
    letter-spacing: .1em;
  }

  .zine-spreads {
    width: min(100%, 1120px);
    margin: 0 auto;
  }

  .zine-spreads--mobile {
    display: none;
  }

  .zine-spread {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    margin: 0 0 52px;
    background: rgba(255, 255, 255, .5);
    box-shadow: 0 26px 58px rgba(54, 43, 29, .18);
  }

  .zine-spread:last-child {
    margin-bottom: 0;
  }

  .zine-sheet {
    position: relative;
    min-width: 0;
  }

  .zine-sheet img {
    display: block;
    width: 100%;
    height: auto;
  }

  .zine-sheet > span {
    position: absolute;
    right: 10px;
    bottom: -24px;
    color: rgba(17, 17, 17, .34);
    font-family: var(--serif);
    font-size: 9px;
  }

  .zine-ending {
    padding: 92px 0 20px;
    text-align: center;
  }

  .zine-ending blockquote {
    margin: 22px 0 0;
  }

  .zine-ending blockquote p {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(27px, 4vw, 40px);
    line-height: 1.45;
  }

  .zine-ending-note {
    margin: 16px 0 30px;
    color: rgba(17, 17, 17, .44);
    font-family: var(--serif);
    font-size: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .book-stage,
    .book-sheet {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .zine-page {
      padding: 40px 0 64px;
    }

    .zine-hero {
      grid-template-columns: 1fr;
      gap: 44px;
      padding-bottom: 64px;
    }

    .zine-heading h1 {
      font-size: clamp(48px, 14vw, 62px);
    }

    .zine-cover {
      width: min(88%, 430px);
      margin-inline: auto;
    }

    .zine-note {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 44px 0 56px;
    }

    .zine-note h2 {
      font-size: 30px;
    }

    .zine-reader {
      padding: 48px 20px 64px;
    }

    .reader-heading {
      align-items: flex-start;
    }

    .reader-heading > span {
      padding-top: 8px;
      text-align: right;
    }

    .book-reader {
      display: none;
    }

    .zine-spreads--mobile {
      display: block;
    }

    .zine-spread {
      grid-template-columns: 1fr;
      gap: 26px;
      margin-bottom: 26px;
      background: transparent;
      box-shadow: none;
    }

    .zine-sheet {
      box-shadow: 0 18px 36px rgba(54, 43, 29, .18);
    }

    .zine-sheet > span {
      display: none;
    }

    .zine-ending {
      padding-top: 68px;
