---
import Shell from '../../components/Shell.astro';
import { listPosts } from '../../lib/notion';

const posts = await listPosts({ includeDrafts: false });
const tagCount = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.tags || []) tagCount.set(tag, (tagCount.get(tag) || 0) + 1);
}
const tags = Array.from(tagCount.entries()).sort((first, second) => second[1] - first[1] || first[0].localeCompare(second[0]));
---

<Shell title="文章标签 — Plan B" description="按标签浏览 Plan B 的文章。">
  <section class="directory-page content-reading">
    <a class="directory-back" href="/blog">← 返回文章</a>
    <header>
      <p>Writing topics</p>
      <h1>文章标签</h1>
      <span>共 {tags.length} 个标签</span>
    </header>

    <div class="tag-directory">
      {tags.map(([tag, count]) => (
        <a href={`/blog/tag/${tag}`}>
          <strong>#{tag}</strong>
          <span>{count} 篇</span>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>
</Shell>

<style>
  .directory-page { padding: 58px 0 88px; }
  .directory-back { color: var(--soft); font-size: 13px; text-decoration: none; }
  header { margin: 36px 0 44px; }
  header p { margin: 0 0 11px; color: var(--soft); font-size: 12px; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 0; font-family: var(--serif); font-size: clamp(42px, 7vw, 60px); line-height: 1; letter-spacing: -.035em; }
  header span { display: block; margin-top: 16px; color: var(--soft); font-size: 12.5px; }
  .tag-directory { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); border-top: 1px solid var(--line2); }
  .tag-directory a { display: grid; grid-template-columns: minmax(0,1fr) auto auto; gap: 12px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .tag-directory a:nth-child(odd) { padding-right: 24px; }
  .tag-directory a:nth-child(even) { padding-left: 24px; border-left: 1px solid var(--line); }
  .tag-directory strong { font-family: var(--serif); font-size: 17px; }
  .tag-directory span { color: var(--soft); font-size: 12px; }
  .tag-directory i { color: rgba(17,17,17,.34); font-size: 12px; font-style: normal; }
  @media (max-width: 600px) { .directory-page { padding: 44px 0 70px; } .tag-directory { grid-template-columns: 1fr; } .tag-directory a:nth-child(n) { padding: 17px 0; border-left: 0; } }
</style>
